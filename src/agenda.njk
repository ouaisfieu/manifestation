---
permalink: /agenda.ics
eleventyExcludeFromCollections: true
layout: false
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//23-11 Le dossier//FR
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Mobilisations sociales — novembre/décembre 2026
X-WR-TIMEZONE:Europe/Brussels
BEGIN:VTIMEZONE
TZID:Europe/Brussels
BEGIN:STANDARD
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
END:STANDARD
BEGIN:DAYLIGHT
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
END:DAYLIGHT
END:VTIMEZONE
{%- for e in agenda %}
BEGIN:VEVENT
UID:{{ e.uid }}@ouaisfieu.github.io
DTSTAMP:20261120T230000Z
{%- if e.allDay %}
DTSTART;VALUE=DATE:{{ e.debut }}
DTEND;VALUE=DATE:{{ e.fin }}
{%- else %}
DTSTART;TZID=Europe/Brussels:{{ e.debut }}
DTEND;TZID=Europe/Brussels:{{ e.fin }}
{%- endif %}
SUMMARY:{{ e.titre | icsEsc }}
LOCATION:{{ e.lieu | icsEsc }}
DESCRIPTION:{{ e.description | icsEsc }} — {{ site.url }}
URL:{{ site.url }}
END:VEVENT
{%- endfor %}
END:VCALENDAR
